datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  KITCHEN_STAFF
  WAITER
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  phone          String?
  role           Role      @default(WAITER)
  isActive       Boolean   @default(true)
  restaurantId   String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  staffProfile   Staff?
  statusChanges  OrderStatusHistory[]

  @@index([restaurantId])
  @@index([email])
}

model Restaurant {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  logo             String?
  coverImage       String?
  address          String
  phone            String
  email            String
  website          String?
  openingHours     String?           @default("10:00 AM - 11:00 PM")
  gstNumber        String?
  taxPercentage    Float             @default(5.0)
  currency         String            @default("₹")
  googleReviewUrl  String?
  description      String?
  customDomain     String?           @unique
  status           RestaurantStatus  @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  branches         Branch[]
  tables           Table[]
  categories       Category[]
  menuItems        MenuItem[]
  orders           Order[]
  customers        Customer[]
  payments         Payment[]
  bills            Bill[]
  notifications    Notification[]
  reviews          Review[]
  settings         RestaurantSettings?
  subscription     Subscription?

  @@index([slug])
  @@index([status])
}

model Branch {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String      @default("Main Branch")
  address      String?
  phone        String?
  isDefault    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tables       Table[]
  orders       Order[]
  staff        Staff[]

  @@index([restaurantId])
}

model Staff {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roleTitle    String      @default("Staff")
  permissions  String      @default("[]") // JSON string of specific granular permissions
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([branchId])
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tableNumber  String      // e.g., "T-01", "Table 05"
  capacity     Int         @default(4)
  isActive     Boolean     @default(true)
  isOccupied   Boolean     @default(false)
  qrCodeUrl    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders       Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
}

model Category {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  menuItems    MenuItem[]

  @@index([restaurantId])
  @@index([restaurantId, displayOrder])
}

model MenuItem {
  id              String      @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Float
  image           String?
  isVeg           Boolean     @default(true)
  prepTimeMinutes Int         @default(15)
  isAvailable     Boolean     @default(true) // AVAILABLE vs OUT OF STOCK
  isRecommended   Boolean     @default(false)
  taxPercentage   Float?      // overrides restaurant default if set
  displayOrder    Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, isAvailable])
}

model Customer {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders       Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, phone])
}

model Order {
  id                  String             @id @default(cuid())
  orderNumber         Int                // Auto-increment per restaurant or global sequential integer
  restaurantId        String
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tableId             String
  table               Table              @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customerId          String?
  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status              OrderStatus        @default(NEW)
  paymentStatus       PaymentStatus      @default(PENDING)
  paymentMethod       PaymentMethod      @default(CASH)
  subtotal            Float              @default(0.0)
  discount            Float              @default(0.0)
  tax                 Float              @default(0.0)
  total               Float              @default(0.0)
  specialInstructions String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  orderItems          OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  bills               Bill[]
  reviews             Review[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([tableId])
}

model OrderItem {
  id                  String    @id @default(cuid())
  orderId             String
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  name                String
  price               Float
  quantity            Int       @default(1)
  specialInstructions String?
  total               Float

  @@index([orderId])
  @@index([menuItemId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  timestamp   DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount         Float
  method         PaymentMethod  @default(CASH)
  status         PaymentStatus  @default(PENDING)
  transactionRef String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([restaurantId])
  @@index([orderId])
}

model Bill {
  id            String        @id @default(cuid())
  billNumber    String        // e.g. "INV-2026-0001"
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subtotal      Float
  discount      Float         @default(0.0)
  tax           Float
  grandTotal    Float
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CASH)
  printedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([restaurantId])
  @@index([billNumber])
}

model Notification {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type         String      // NEW_ORDER, ORDER_PREPARING, ORDER_READY, LOW_STOCK, etc.
  title        String
  message      String
  data         String?     // JSON metadata
  isRead       Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([restaurantId])
  @@index([restaurantId, isRead])
}

model Review {
  id                   String      @id @default(cuid())
  restaurantId         String
  restaurant           Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId              String?
  order                Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName         String
  customerPhone        String?
  rating               Int         // 1 to 5
  comment              String?
  submittedGoogleReview Boolean    @default(false)
  createdAt            DateTime    @default(now())

  @@index([restaurantId])
  @@index([restaurantId, rating])
}

model RestaurantSettings {
  id                    String      @id @default(cuid())
  restaurantId          String      @unique
  restaurant            Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  enableKdsSound        Boolean     @default(true)
  serviceChargePercent  Float       @default(0.0)
  receiptFooter         String?     @default("Thank you for dining with us! Please visit again.")
  autoAcceptOrders      Boolean     @default(false)
  updatedAt             DateTime    @updatedAt
}

model Subscription {
  id                 String           @id @default(cuid())
  restaurantId       String           @unique
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan @default(PRO)
  status             String           @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startDate          DateTime         @default(now())
  endDate            DateTime?
  maxTables          Int              @default(50)
  maxOrdersPerMonth  Int              @default(5000)
  updatedAt          DateTime         @updatedAt
}
